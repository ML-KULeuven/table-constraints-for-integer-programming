@incollection{hutchison_modeling_2007,
	location = {Berlin, Heidelberg},
	title = {Modeling the Regular Constraint with Integer Programming},
	volume = {4510},
	isbn = {978-3-540-72396-7 978-3-540-72397-4},
	url = {http://link.springer.com/10.1007/978-3-540-72397-4_3},
	doi = {10.1007/978-3-540-72397-4_3},
	abstract = {Many optimisation problems contain substructures involving constraints on sequences of decision variables. Such constraints can be very complex to express with mixed integer programming ({MIP}), while in constraint programming ({CP}), the global constraint regular easily represents this kind of substructure with deterministic ﬁnite automata ({DFA}). In this paper, we use {DFAs} and the associated layered graph structure built for the regular constraint consistency algorithm to develop a {MIP} version of the constraint. We present computational results on an employee timetabling problem, showing that this new modeling approach can signiﬁcantly decrease computational times in comparison with a classical {MIP} formulation.},
	pages = {29--43},
	booktitle = {Integration of {AI} and {OR} Techniques in Constraint Programming for Combinatorial Optimization Problems},
	publisher = {Springer Berlin Heidelberg},
	author = {Côté, Marie-Claude and Gendron, Bernard and Rousseau, Louis-Martin},
	editor = {Van Hentenryck, Pascal and Wolsey, Laurence},
	editorb = {Hutchison, David and Kanade, Takeo and Kittler, Josef and Kleinberg, Jon M. and Mattern, Friedemann and Mitchell, John C. and Naor, Moni and Nierstrasz, Oscar and Rangan, C. Pandu and Steffen, Bernhard and Sudan, Madhu and Terzopoulos, Demetri and Tygar, Doug and Vardi, Moshe Y. and Weikum, Gerhard},
	editorbtype = {redactor},
	urldate = {2026-01-28},
	date = {2007},
	langid = {english},
	note = {Series Title: Lecture Notes in Computer Science},
	file = {PDF:C\:\\Users\\Wout\\Zotero\\storage\\WEE55JAM\\Côté et al. - 2007 - Modeling the Regular Constraint with Integer Programming.pdf:application/pdf},
